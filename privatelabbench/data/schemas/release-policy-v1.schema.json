{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "PrivateLabBench release policy v1",
  "type": "object",
  "required": ["schema_version", "id"],
  "properties": {
    "schema_version": {"const": "release-policy/v1"},
    "id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9_.@+-]{0,127}$"},
    "enabled": {"type": "boolean", "default": false},
    "min_samples": {"type": "integer", "minimum": 2, "default": 20},
    "min_cell_size": {"type": "integer", "minimum": 2, "default": 5},
    "require_privacy_audit": {"type": "boolean", "default": true},
    "include_input_schema": {"type": "boolean", "default": false},
    "include_quality_gate": {"type": "boolean", "default": false},
    "public_benchmark": {
      "type": "object",
      "properties": {"id": {"type": "string"}, "version": {"type": "string"}, "suite": {"type": "string"}, "domain": {"type": "string"}, "protocol": {"type": "string"}},
      "additionalProperties": false
    },
    "slices": {
      "type": "object", "maxProperties": 1,
      "additionalProperties": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string"}}
    },
    "reviewed_repeat": {"type": "boolean", "default": false},
    "review_reference": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9_.@+-]{0,127}$"}
  },
  "allOf": [{"if": {"required": ["reviewed_repeat"], "properties": {"reviewed_repeat": {"const": true}}}, "then": {"required": ["review_reference"]}}],
  "additionalProperties": false
}
