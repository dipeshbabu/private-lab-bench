{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "PrivateLabBench release policy v1",
  "type": "object",
  "required": ["schema_version", "id"],
  "properties": {
    "schema_version": {"const": "release-policy/v1"},
    "id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9_.@+-]{0,127}$"},
    "enabled": {"type": "boolean", "default": false},
    "min_samples": {"type": "integer", "minimum": 2, "default": 20},
    "min_cell_size": {"type": "integer", "minimum": 2, "default": 5},
    "require_privacy_audit": {"type": "boolean", "default": true},
    "require_design_audit": {"type": "boolean", "default": false},
    "include_design_audit": {"type": "boolean", "default": false},
    "include_input_schema": {"type": "boolean", "default": false},
    "include_quality_gate": {"type": "boolean", "default": false},
    "include_source_receipts": {"type": "boolean", "default": false},
    "public_series": {"type": "object", "required": ["id", "revision"], "properties": {"id": {"type": "string"}, "revision": {"type": "string"}}, "additionalProperties": false},
    "public_times": {"type": "array", "minItems": 2, "maxItems": 1000, "uniqueItems": true, "items": {"type": "string"}},
    "include_protocol": {"type": "boolean", "default": false},
    "public_validation": {
      "type": "object", "required": ["model", "dataset", "evaluator_relationship"],
      "properties": {
        "model": {"$ref": "external-validation-profile-v1.schema.json#/$defs/model"},
        "dataset": {"$ref": "external-validation-profile-v1.schema.json#/$defs/dataset"},
        "evaluator_relationship": {"$ref": "external-validation-profile-v1.schema.json#/$defs/relationship"},
        "prediction_artifact_sha256": {"$ref": "external-validation-profile-v1.schema.json#/$defs/digest"},
        "prediction_artifact_basis": {"enum": ["input_file_bytes", "audited_frame_csv"]}
      }, "additionalProperties": false
    },
    "include_degradation": {"type": "boolean", "default": false},
    "include_slice_inference": {"type": "boolean", "default": false},
    "include_multiplicity": {"type": "boolean", "default": false},
    "public_shift_features": {"type": "array", "uniqueItems": true, "items": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9_.@+-]{0,127}$"}},
    "public_sites": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9_.@+-]{0,127}$"}},
    "public_models": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "object", "required": ["id", "revision"], "properties": {"id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:/@+-]{0,199}$"}, "revision": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:/@+-]{0,199}$"}}, "additionalProperties": false}},
    "public_benchmark": {
      "type": "object",
      "properties": {"id": {"type": "string"}, "version": {"type": "string"}, "suite": {"type": "string"}, "domain": {"type": "string"}, "protocol": {"type": "string"}},
      "additionalProperties": false
    },
    "slices": {
      "type": "object", "maxProperties": 1,
      "additionalProperties": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string"}}
    },
    "reviewed_repeat": {"type": "boolean", "default": false},
    "review_reference": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9_.@+-]{0,127}$"}
  },
  "allOf": [{"if": {"required": ["reviewed_repeat"], "properties": {"reviewed_repeat": {"const": true}}}, "then": {"required": ["review_reference"]}}],
  "additionalProperties": false
}
