{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "PrivateLabBench cross-site aggregate v1",
  "type": "object",
  "required": ["schema_version", "scope", "shareable", "integrity"],
  "properties": {
    "schema_version": {"const": "cross-site-aggregate/v1"},
    "scope": {"enum": ["local", "shareable"]},
    "aggregate_id": {"type": "string"},
    "created_at": {"type": "string"},
    "shareable": {
      "type": "object",
      "required": ["protocol", "task_type", "metric", "input_family", "models", "paired_sites", "paired_models", "limitations", "assume_disjoint_sites", "range_threshold"],
      "properties": {
        "protocol": {"type": "object", "required": ["id", "version", "sha256", "metrics", "primary_metric"], "properties": {"id": {"type": "string", "pattern": "^plb://"}, "version": {"type": "string"}, "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"}, "metrics": {"type": "array", "items": {"type": "string"}}, "primary_metric": {"type": "string"}}, "additionalProperties": false},
        "task_type": {"enum": ["regression", "classification", "multiclass"]},
        "metric": {"enum": ["mae", "rmse", "r2", "spearman", "accuracy", "f1", "auroc", "macro_f1", "weighted_f1", "log_loss", "macro_auroc_ovr"]},
        "input_family": {"enum": ["evaluation-receipt/v1", "paired-comparison-artifact/v1"]},
        "assume_disjoint_sites": {"type": "boolean"},
        "range_threshold": {"type": ["number", "null"], "minimum": 0},
        "models": {"type": "array", "minItems": 1, "items": {"type": "object", "required": ["model", "sites", "summary"], "properties": {"model": {"$ref": "#/$defs/model"}, "sites": {"type": "array", "minItems": 2, "items": {"$ref": "#/$defs/site"}}, "summary": {"type": "object", "required": ["total_samples", "n_sites", "range", "pooled"]}}, "additionalProperties": false}},
        "paired_sites": {"type": "array", "items": {"type": "object", "required": ["site", "n_samples", "improvement_a_over_b", "interval"], "properties": {"site": {"type": "string"}, "n_samples": {"type": "integer", "minimum": 2}, "improvement_a_over_b": {"type": "number"}, "interval": {"type": "object"}}, "additionalProperties": false}},
        "paired_models": {"type": "array", "items": {"$ref": "#/$defs/model"}},
        "limitations": {"type": "array", "items": {"type": "string"}},
        "release": {"type": "object"}
      },
      "additionalProperties": false
    },
    "local": {"type": "object"},
    "integrity": {"type": "object"},
    "signer_statement": {"type": "object"}
  },
  "allOf": [{"if": {"properties": {"scope": {"const": "shareable"}}}, "then": {"required": ["aggregate_id", "created_at"], "not": {"required": ["local"]}}}],
  "additionalProperties": false,
  "$defs": {
    "model": {"type": "object", "required": ["id", "revision"], "properties": {"id": {"type": "string"}, "revision": {"type": "string"}}, "additionalProperties": false},
    "site": {"type": "object", "required": ["site", "n_samples", "estimate", "interval", "confidence_level", "privacy_mode"], "properties": {"site": {"type": "string"}, "n_samples": {"type": "integer", "minimum": 2}, "estimate": {"type": "number"}, "interval": {"type": "object"}, "confidence_level": {"type": ["number", "null"], "exclusiveMinimum": 0, "exclusiveMaximum": 1}, "privacy_mode": {"enum": ["none", "metric_perturbation"]}}, "additionalProperties": false}
  }
}
