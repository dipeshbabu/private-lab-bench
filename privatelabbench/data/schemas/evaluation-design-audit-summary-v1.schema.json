{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "PrivateLabBench evaluation-design audit summary v1",
  "anyOf": [
    {
      "type": "object",
      "properties": {
        "schema_version": {
          "const": "evaluation-design-audit/v1"
        },
        "algorithm": {
          "const": "split-audit/v1"
        },
        "status": {
          "enum": [
            "pass",
            "warn",
            "fail",
            "not_testable"
          ]
        },
        "definition_sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "training_reference_present": {
          "type": "boolean"
        },
        "reference_declared_complete": {
          "type": "boolean"
        },
        "scope": {
          "const": "provided_records_only"
        },
        "n_evaluation_records": {
          "type": "integer",
          "minimum": 0
        },
        "n_input_records": {
          "type": "integer",
          "minimum": 0
        },
        "n_reference_records": {
          "type": "integer",
          "minimum": 0
        },
        "n_checked_records": {
          "type": "integer",
          "minimum": 0
        },
        "excluded_evaluation_records": {
          "type": "integer",
          "minimum": 0
        },
        "findings": {
          "type": "object",
          "required": [
            "training_reference_coverage"
          ],
          "propertyNames": {
            "enum": [
              "training_reference_coverage",
              "evaluation_duplicate_ids",
              "reference_duplicate_ids",
              "sample_id_overlap",
              "entity_overlap",
              "repeated_entities",
              "conflicting_labels",
              "group_overlap",
              "chronology",
              "invalid_molecules",
              "molecular_identity",
              "scaffold_overlap",
              "near_duplicates"
            ]
          },
          "additionalProperties": {
            "type": "object",
            "properties": {
              "status": {
                "enum": [
                  "pass",
                  "warn",
                  "fail",
                  "not_testable"
                ]
              },
              "affected_records": {
                "type": [
                  "integer",
                  "null"
                ],
                "minimum": 0
              },
              "evidence_complete": {
                "type": "boolean"
              },
              "policy": {
                "enum": [
                  "allow",
                  "warn",
                  "forbid"
                ]
              },
              "reason": {
                "type": "string"
              }
            },
            "required": [
              "status",
              "affected_records",
              "evidence_complete",
              "policy"
            ],
            "additionalProperties": false
          }
        },
        "adapter": {
          "enum": [
            null,
            "rdkit-molecule/v1"
          ]
        },
        "adapter_version": {
          "type": [
            "string",
            "null"
          ]
        },
        "limitations": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "model_role": {
          "enum": [
            "model_a",
            "model_b"
          ]
        }
      },
      "required": [
        "schema_version",
        "algorithm",
        "status",
        "definition_sha256",
        "training_reference_present",
        "reference_declared_complete",
        "scope",
        "n_evaluation_records",
        "n_input_records",
        "n_reference_records",
        "n_checked_records",
        "excluded_evaluation_records",
        "findings",
        "adapter",
        "limitations"
      ],
      "additionalProperties": false
    },
    {
      "type": "object",
      "properties": {
        "schema_version": {
          "const": "evaluation-design-audit/v1"
        },
        "status": {
          "const": "withheld_small_audit_cells"
        },
        "scope": {
          "const": "provided_records_only"
        },
        "model_role": {
          "enum": [
            "model_a",
            "model_b"
          ]
        }
      },
      "required": [
        "schema_version",
        "status",
        "scope"
      ],
      "additionalProperties": false
    }
  ]
}
