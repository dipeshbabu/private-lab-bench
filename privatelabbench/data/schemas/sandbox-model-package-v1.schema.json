{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "PrivateLabBench sandbox model package manifest v1",
  "type": "object",
  "required": ["schema_version", "entrypoint", "files"],
  "properties": {
    "schema_version": {"const": "sandbox-model-package/v1"},
    "entrypoint": {"type": "string", "maxLength": 256, "pattern": "^(?:[A-Za-z0-9_][A-Za-z0-9_.-]*/){0,15}[A-Za-z0-9_][A-Za-z0-9_.-]*\\.py$"},
    "files": {
      "type": "object",
      "minProperties": 1,
      "maxProperties": 128,
      "propertyNames": {"maxLength": 256, "pattern": "^(?:[A-Za-z0-9_][A-Za-z0-9_.-]*/){0,15}[A-Za-z0-9_][A-Za-z0-9_.-]*$"},
      "additionalProperties": {"type": "string", "pattern": "^[a-f0-9]{64}$"}
    }
  },
  "additionalProperties": false
}
