{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://privatelabbench.org/schemas/external-validation-v1.schema.json",
  "title": "Declared external-validation summary v1",
  "type": "object",
  "required": ["schema_version", "model", "dataset", "evaluator_relationship", "claim_scope", "independence_verified"],
  "properties": {
    "schema_version": {"const": "external-validation/v1"},
    "model": {"$ref": "external-validation-profile-v1.schema.json#/$defs/model"},
    "dataset": {"$ref": "external-validation-profile-v1.schema.json#/$defs/dataset"},
    "evaluator_relationship": {"$ref": "external-validation-profile-v1.schema.json#/$defs/relationship"},
    "relationship_statement": {"type": ["string", "null"], "maxLength": 1200},
    "prediction_artifact_sha256": {"$ref": "external-validation-profile-v1.schema.json#/$defs/digest"},
    "prediction_artifact_basis": {"enum": ["input_file_bytes", "audited_frame_csv"]},
    "claim_scope": {"const": "declared_external_evaluation"},
    "independence_verified": {"const": false}
  },
  "additionalProperties": false
}
