# Copy this file to .env and replace every change-me value before production use.

PRIVATELABBENCH_ENV=production
PRIVATELABBENCH_IMAGE_TAG=0.10.0

# Hosted dashboard for sanitized benchmark metadata.
PRIVATELABBENCH_DASHBOARD_PORT=8010
PRIVATELABBENCH_DASHBOARD_API_KEY=change-me-dashboard-secret
PRIVATELABBENCH_DASHBOARD_DB=/data/dashboard.db

# Optional local API service for launching private runs inside the customer environment.
PRIVATELABBENCH_API_PORT=8000
PRIVATELABBENCH_API_KEY=change-me-local-api-secret
PRIVATELABBENCH_RUN_ROOT=/data/runs

# Optional report signing secret used by verify-report when signed reports are enabled.
PRIVATELABBENCH_SIGNING_SECRET=change-me-report-signing-secret
